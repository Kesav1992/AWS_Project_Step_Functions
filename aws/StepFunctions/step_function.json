{
  "Comment": "Data Processing StepFunction",
  "StartAt": "Lambda1",
  "States": {
    "Lambda1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${Lambda1FunctionArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "lambda1_file.$": "$.Payload.lambda1_file"
      },
      "ResultPath": "$.lambda1",
      "Next": "Lambda2"
    },
    "Lambda2": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${Lambda2FunctionArn}",
        "Payload": {
          "bucket.$": "$.bucket",
          "lambda1_file.$": "$.lambda1.lambda1_file"
        }
      },
      "ResultSelector": {
        "lambda2_file.$": "$.Payload.lambda2_file"
      },
      "ResultPath": "$.lambda2",
      "Next": "Lambda3"
    },
    "Lambda3": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${Lambda3FunctionArn}",
        "Payload": {
          "bucket.$": "$.bucket",
          "lambda2_file.$": "$.lambda2.lambda2_file"
        }
      },
      "ResultSelector": {
        "lambda3_file.$": "$.Payload.lambda3_file"
      },
      "ResultPath": "$.lambda3",
      "Next": "Lambda4"
    },
    "Lambda4": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${Lambda4FunctionArn}",
        "Payload": {
          "bucket.$": "$.bucket",
          "lambda3_file.$": "$.lambda3.lambda3_file"
        }
      },
      "ResultPath": "$.lambda4",
      "End": true
    }
  }
}